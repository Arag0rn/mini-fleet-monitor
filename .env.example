# API
PORT=4000
# Local dev (npm run dev) needs a random string of 32+ characters here.
# Leave it empty for docker compose: an empty value falls back to the demo-only default in docker-compose.yml.
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Postgres
DATABASE_URL=postgres://fleet:fleet@localhost:5433/fleet

# Redis
REDIS_URL=redis://localhost:6379
